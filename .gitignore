# =====================================================================
# 本仓库只提交我自己写的脚本和文档。
# 引擎本体、.venv 虚拟环境、模型权重、素材与产物一律不入库，按 README 重新部署。
# =====================================================================

# ---- IndexTTS-2.5（上游：https://github.com/index-tts/index-tts）----
/index-tts/*
!/index-tts/tts_server.py

# ---- GPT-SoVITS（上游：https://github.com/RVC-Boss/GPT-SoVITS）----
/GPT-SoVITS/*
!/GPT-SoVITS/api_server.py
!/GPT-SoVITS/webui/
!/GPT-SoVITS/requirements_win_deploy.txt

# ---- 统一工作台（自己写的部分全部入库；配置与产物除外）----
/工作台/*
!/工作台/server.py
!/工作台/train_voice.py
!/工作台/deepseek_client.py
!/工作台/engines.py
!/工作台/约束文档.md
!/工作台/config.example.yaml
!/工作台/static/
/工作台/config.yaml       # 里面有 DeepSeek API key，不入库
/工作台/voice_config.json
/工作台/outputs/
/工作台/logs/
/工作台/训练数据/
/工作台/model_cache/

# ---- 训练素材（用户录音不入库，保留说明文件）----
/训练素材/*
!/训练素材/放录音到这里.txt

# ---- 环境与产物（本地部署时生成/下载，一律不入库）----
.venv/
venv/
pretrained_models/
checkpoints/
asset/
hf_cache/
logs/
__pycache__/
*.log
演示音频/
解说音频/

# ---- 需求原稿不入库 ----
部署文档.txt
