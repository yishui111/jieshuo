# =====================================================================
# 本仓库只提交我自己写的脚本和文档。
# 引擎本体、.venv 虚拟环境、模型权重、素材与产物一律不入库，按各项目 README 重新部署。
# =====================================================================

# ---- 项目一引擎 GPT-SoVITS（上游：https://github.com/RVC-Boss/GPT-SoVITS）----
/项目一-专属声音/GPT-SoVITS/*
!/项目一-专属声音/GPT-SoVITS/api_server.py
!/项目一-专属声音/GPT-SoVITS/webui/
!/项目一-专属声音/GPT-SoVITS/requirements_win_deploy.txt
!/项目一-专属声音/GPT-SoVITS/启动_API.bat
!/项目一-专属声音/GPT-SoVITS/启动_WebUI.bat
!/项目一-专属声音/GPT-SoVITS/启动_演示.bat
!/项目一-专属声音/GPT-SoVITS/关闭服务.bat
!/项目一-专属声音/GPT-SoVITS/参考音频/

# ---- 项目二引擎 IndexTTS-2.5（上游：https://github.com/index-tts/index-tts）----
/项目二-情感解说/index-tts/*
!/项目二-情感解说/index-tts/tts_server.py

# ---- 项目一：训练素材（用户录音不入库，保留说明文件）----
/项目一-专属声音/训练素材/*
!/项目一-专属声音/训练素材/放录音到这里.txt

# ---- 各项目本机配置与运行产物（不入库）----
项目一-专属声音/config.yaml
项目一-专属声音/voice_config.json
项目一-专属声音/训练数据/
项目一-专属声音/model_cache/
项目二-情感解说/config.yaml
项目二-情感解说/model_cache/

.venv/
venv/
logs/
hf_cache/
checkpoints/
__pycache__/
*.log

# ---- 生成音频不入库 ----
解说音频/

# ---- 需求原稿不入库 ----
部署文档.txt

# ---- 测试产物（截图/音频/视频不入库，测试报告入库）----
/项目一-专属声音/测试/*
!/项目一-专属声音/测试/测试报告.md
/项目二-情感解说/测试/*
!/项目二-情感解说/测试/测试报告.md
